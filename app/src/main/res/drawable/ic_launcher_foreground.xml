<?xml version="1.0" encoding="utf-8"?>
<!--
  Sun behind a cloud, drawn by hand so the icon needs no image tooling and no bitmap.
  The 108dp canvas is the adaptive-icon standard; the outer 18dp on each side is bleed
  the launcher may mask away, so the artwork stays inside the middle 72dp.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Sun rays, upper right -->
    <group android:name="rays">
        <path
            android:fillColor="#FFC24B"
            android:pathData="M67,22 h4 v-9 h-4 z" />
        <path
            android:fillColor="#FFC24B"
            android:pathData="M84.4,29.8 l2.8,2.8 6.4,-6.4 -2.8,-2.8 z" />
        <path
            android:fillColor="#FFC24B"
            android:pathData="M88,45 v4 h9 v-4 z" />
        <path
            android:fillColor="#FFC24B"
            android:pathData="M50.2,25.4 l2.8,-2.8 -6.4,-6.4 -2.8,2.8 z" />
    </group>

    <!-- Sun disc -->
    <path
        android:fillColor="#FFB300"
        android:pathData="M69,29 m-16,0 a16,16 0 1,0 32,0 a16,16 0 1,0 -32,0 z" />

    <!-- Cloud, overlapping the sun's lower left -->
    <path
        android:fillColor="#ECEFF1"
        android:pathData="M36,76 a15,15 0 0,1 0.6,-30 a21,21 0 0,1 39.4,5 a13,13 0 0,1 -2,25 z" />

    <!-- Two rain drops -->
    <path
        android:fillColor="#4FC3F7"
        android:pathData="M45,82 q4,6 4,8.5 a4,4 0 0,1 -8,0 q0,-2.5 4,-8.5 z" />
    <path
        android:fillColor="#4FC3F7"
        android:pathData="M65,82 q4,6 4,8.5 a4,4 0 0,1 -8,0 q0,-2.5 4,-8.5 z" />
</vector>
